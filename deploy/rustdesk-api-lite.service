# systemd unit for rustdesk-api-lite.
# Install:
#   install -m 755 rustdesk-api-lite /usr/local/bin/
#   useradd --system --no-create-home --shell /usr/sbin/nologin rustdesk-api-lite
#   cp deploy/rustdesk-api-lite.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now rustdesk-api-lite
# The first start prints the password of the "admin" account: journalctl -u rustdesk-api-lite
# Command-line use needs the same user and database, for example:
#   sudo -u rustdesk-api-lite rustdesk-api-lite user list -db /var/lib/rustdesk-api-lite/rustdesk-api-lite.db
[Unit]
Description=RustDesk API Lite (accounts, address books, console)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/rustdesk-api-lite serve
Environment=RDL_DB=/var/lib/rustdesk-api-lite/rustdesk-api-lite.db
Environment=RDL_LISTEN=127.0.0.1:21114
# Set when a reverse proxy (Caddy, nginx) sits in front and adds X-Forwarded-*.
Environment=RDL_TRUST_PROXY=1
# Local settings go into this file (NAME=value lines); it wins over the lines above.
# RDL_LISTEN moves the port. RDL_PUBLIC_URL, RDL_ID_SERVER, RDL_RELAY_SERVER and
# RDL_KEY (the content of hbbs's id_ed25519.pub) fill the settings on the first
# start; afterwards they are changed in the console or with `rustdesk-api-lite config set`.
EnvironmentFile=-/etc/rustdesk-api-lite.env
User=rustdesk-api-lite
StateDirectory=rustdesk-api-lite
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target
